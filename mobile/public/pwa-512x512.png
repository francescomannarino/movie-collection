<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <!-- Background -->
  <rect width="512" height="512" rx="96" fill="#0f0f23"/>
  
  <!-- Main film reel -->
  <circle cx="256" cy="256" r="160" fill="#fbbf24"/>
  <circle cx="256" cy="256" r="120" fill="#0f0f23"/>
  
  <!-- Film holes -->
  <circle cx="256" cy="136" r="20" fill="#fbbf24"/>
  <circle cx="256" cy="376" r="20" fill="#fbbf24"/>
  <circle cx="136" cy="256" r="20" fill="#fbbf24"/>
  <circle cx="376" cy="256" r="20" fill="#fbbf24"/>
  
  <!-- Diagonal holes -->
  <circle cx="185" cy="185" r="15" fill="#fbbf24"/>
  <circle cx="327" cy="185" r="15" fill="#fbbf24"/>
  <circle cx="185" cy="327" r="15" fill="#fbbf24"/>
  <circle cx="327" cy="327" r="15" fill="#fbbf24"/>
  
  <!-- Center -->
  <circle cx="256" cy="256" r="40" fill="#fbbf24"/>
  <circle cx="256" cy="256" r="20" fill="#0f0f23"/>
  
  <!-- Film strip -->
  <rect x="80" y="200" width="352" height="112" fill="#fbbf24" opacity="0.3"/>
  <rect x="80" y="220" width="352" height="8" fill="#0f0f23"/>
  <rect x="80" y="240" width="352" height="8" fill="#0f0f23"/>
  <rect x="80" y="260" width="352" height="8" fill="#0f0f23"/>
  <rect x="80" y="280" width="352" height="8" fill="#0f0f23"/>
  
  <!-- Small perforations -->
  <rect x="90" y="210" width="6" height="6" fill="#0f0f23"/>
  <rect x="110" y="210" width="6" height="6" fill="#0f0f23"/>
  <rect x="130" y="210" width="6" height="6" fill="#0f0f23"/>
  <rect x="150" y="210" width="6" height="6" fill="#0f0f23"/>
  
  <rect x="90" y="296" width="6" height="6" fill="#0f0f23"/>
  <rect x="110" y="296" width="6" height="6" fill="#0f0f23"/>
  <rect x="130" y="296" width="6" height="6" fill="#0f0f23"/>
  <rect x="150" y="296" width="6" height="6" fill="#0f0f23"/>
</svg>
