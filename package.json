{
  "name": "movie-collection-webapp",
  "version": "1.0.0",
  "description": "Webapp per gestire collezione personale di film DVD/Blu-ray",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup": "node setup.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop movie-collection-webapp",
    "pm2:restart": "pm2 restart movie-collection-webapp",
    "pm2:reload": "pm2 reload movie-collection-webapp",
    "pm2:delete": "pm2 delete movie-collection-webapp",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs movie-collection-webapp",
    "pm2:monit": "pm2 monit",
    "deploy": "./deploy.sh"
  },
  "keywords": ["movie", "collection", "dvd", "bluray", "tmdb"],
  "author": "Francesco",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.5.1",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
