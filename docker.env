# Configurazione per Docker
# Copia questo file come .env prima di avviare i container

# TMDB API Configuration (OBBLIGATORIO)
# Ottieni la tua API key da: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Database Configuration (gestito automaticamente da Docker Compose)
MONGODB_URI=mongodb://mongodb:27017/movie-collection

# TMDB URLs (non modificare)
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Server Configuration
PORT=3000
NODE_ENV=production

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
